# Runtime Environment ("development" or "production")
APP_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=127.0.0.1,::1
ENABLE_TEST_ENDPOINTS=false
MOCK_VISION_API=false

# MongoDB Atlas or Local Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fitmate_db

# Twilio WhatsApp Cloud Sandbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# OpenRouter AI Model Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_OCR_API_KEY=your_openrouter_ocr_api_key
OPENROUTER_OCR_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_CHATBOT_API_KEY=your_openrouter_chatbot_api_key
OPENROUTER_CHATBOT_MODEL=google/gemini-2.5-flash-lite

# Admin Authentication (JWT) — MUST be >= 32 random chars in production
JWT_SECRET_KEY=generate_a_random_32_character_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Hugging Face Deployment Token (local deploy script only — never commit real values)
HF_TOKEN=your_huggingface_write_token
